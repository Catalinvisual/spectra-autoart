# Use multi-stage build for optimization
FROM node:20-alpine AS client-builder

WORKDIR /app/client

# Copy client files
COPY client/package.json ./
RUN npm install

COPY client/ ./
RUN npm run build

# Production stage
FROM node:20-alpine AS production

WORKDIR /app

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Create non-root user
RUN addgroup -g 1001 -S nodejs
RUN adduser -S nodejs -u 1001

# Copy root package.json
COPY package.json ./

# Copy and install server dependencies
COPY server/package.json ./server/
RUN cd server && npm install --omit=dev && npm cache clean --force

# Copy server source code and environment files
COPY server/src/ ./server/src/
COPY server/scripts/ ./server/scripts/
COPY server/.env.production ./server/.env

# Copy built client files
COPY --from=client-builder /app/client/dist ./client/dist

# Set ownership to nodejs user
RUN chown -R nodejs:nodejs /app
USER nodejs

# Expose port
EXPOSE 8080

# Health check endpoint - increased start period and retries for Railway
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=10 \
  CMD node -e "const http = require('http'); const options = { host: 'localhost', port: 8080, timeout: 8000, path: '/health' }; const req = http.request(options, (res) => { if (res.statusCode === 200) process.exit(0); else process.exit(1); }); req.on('error', () => process.exit(1)); req.end();" || exit 1

# Start application with dumb-init
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "server/src/index.js"]