{
  "build": {
    "buildCommand": "cd client && npm install && npm run build && cd ../server && npm install",
    "startCommand": "cd server && npm start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "deploy": {
    "startCommand": "cd server && npm start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}