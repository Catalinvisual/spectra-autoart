# ============================================
# SPECTRA AUTOART - RAILWAY ENVIRONMENT VARIABLES
# ============================================

# REQUIRED VARIABLES - MUST BE CONFIGURED
# ======================================

# Google Sheets API (REQUIRED pentru funcționalitatea de bază)
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email_here
GOOGLE_PRIVATE_KEY=your_private_key_here

# JWT Secret (REQUIRED pentru autentificare)
JWT_SECRET=your_jwt_secret_here_min_32_characters

# Admin Credentials (REQUIRED pentru acces admin)
ADMIN_DEFAULT_EMAIL=admin@spectraautoart.com
ADMIN_DEFAULT_PASSWORD=your_secure_admin_password

# Server Configuration (AUTO-SET by Railway)
# PORT=8080  # Railway setează automat această variabilă
CLIENT_ORIGIN=https://spectra-autoart-production.up.railway.app

# OPTIONAL VARIABLES - PENTRU FUNCȚII AVANSATE
# =============================================

# Twilio Configuration (OPȚIONAL - pentru notificări WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=+1234567890
ADMIN_WHATSAPP_TO=+1234567890

# Gmail Configuration (OPȚIONAL - pentru notificări email)
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token
GMAIL_SENDER_EMAIL=spectraautoart@gmail.com



# Azure Translator (OPȚIONAL - alternativă la Google Translate)
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_KEY=your_azure_translator_key
AZURE_TRANSLATOR_REGION=your_azure_region

# Max Bookings Configuration (OPȚIONAL)
MAX_BOOKINGS_PER_DAY=5

# ============================================
# INSTRUCȚIUNI DE CONFIGURARE
# ============================================

# 1. GOOGLE SHEETS SETUP:
#    - Creează un Google Sheets nou
#    - Partajează cu service account email
#    - Copiază ID-ul spreadsheet-ului din URL

# 2. GOOGLE SERVICE ACCOUNT:
#    - Mergi la Google Cloud Console
#    - Creează un service account
#    - Generează cheie privată JSON
#    - Converteste cheia privată la format single line

# 3. JWT SECRET:
#    - Generează un string random de minim 32 caractere
#    - Poți folosi: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# 4. TWILIO (Optional):
#    - Creează cont Twilio
#    - Verifică numărul de WhatsApp
#    - Obține credențialele din dashboard

# 5. GMAIL (Optional):
#    - Setup OAuth2 in Google Cloud Console
#    - Obține client ID, secret și refresh token