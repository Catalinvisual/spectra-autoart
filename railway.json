{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "./Dockerfile.production"
  },
  "deploy": {
    "startCommand": "node railway-start.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "environments": {
    "production": {
      "buildCommand": "npm run build",
      "startCommand": "node railway-start.js"
    }
  }
}