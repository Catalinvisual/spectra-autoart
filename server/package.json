{
  "name": "spectraautoart-server",
  "version": "1.0.0",
  "description": "Backend API pentru Spectra AutoArt",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "set NODE_ENV=development&& node src/index.js",
    "start": "set NODE_ENV=production&& node src/index.js",
    "build": "rm -rf ../client/dist && rm -rf ../client/build && cd ../client && npm ci && npm run build && cd ../server && echo 'Build complete'"
  },
