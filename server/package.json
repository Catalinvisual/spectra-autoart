    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "deepl-node": "^1.13.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "form-data": "^4.0.5",
    "google-spreadsheet": "^5.0.2",
    "googleapis": "^137.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.11",
    "twilio": "^4.23.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
