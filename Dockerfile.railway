# Dummy Dockerfile - Railway should use native configuration instead
FROM node:18-alpine

WORKDIR /app

# Copy all files
COPY . .

# Install dependencies
RUN npm ci

# Build client
RUN cd client && npm ci && npm run build

# Install server dependencies
RUN cd server && npm ci --only=production

# Use Railway's native start command
CMD ["sh", "-c", "echo 'Using Railway native configuration' && sh start.sh"]