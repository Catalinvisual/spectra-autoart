# Railway Production Dockerfile - Complete Build
FROM node:20-alpine

# Set working directory
WORKDIR /app

# Install build dependencies
RUN apk add --no-cache python3 make g++

# Copy source code first
COPY . .

# Remove postinstall script to avoid conflicts
RUN npm pkg delete scripts.postinstall

# Install root dependencies
RUN npm ci --only=production

# Install server dependencies
RUN cd server && npm ci --only=production

# Install client dependencies (include dev dependencies for build) and build
RUN cd client && npm ci --include=dev && npm run build

# Make railway-start.js executable
RUN chmod +x railway-start.js

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=120s --retries=5 \
  CMD node -e "require('http').get('http://localhost:8080/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) }).on('error', () => process.exit(1))"

# Start command
CMD ["node", "railway-start.js"]