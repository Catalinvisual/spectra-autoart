# Environment Variables Configuration for Railway

# Server Configuration
PORT=8080
CLIENT_ORIGIN=https://spectra-autoart-production.up.railway.app

# Google Sheets API Configuration
# Replace with your actual Google Sheets credentials
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email_here
GOOGLE_PRIVATE_KEY=your_private_key_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_min_32_characters

# Admin Credentials
ADMIN_DEFAULT_EMAIL=admin@spectraautoart.com
ADMIN_DEFAULT_PASSWORD=your_secure_admin_password

# Optional: Twilio Configuration (for WhatsApp notifications)
TWILIO_ACCOUNT_SID=optional_twilio_account_sid
TWILIO_AUTH_TOKEN=optional_twilio_auth_token
TWILIO_WHATSAPP_FROM=optional_twilio_whatsapp_number
ADMIN_WHATSAPP_TO=optional_admin_whatsapp_number

# Optional: Gmail Configuration (for email notifications)
GMAIL_CLIENT_ID=optional_gmail_client_id
GMAIL_CLIENT_SECRET=optional_gmail_client_secret
GMAIL_REFRESH_TOKEN=optional_gmail_refresh_token
GMAIL_SENDER_EMAIL=optional_gmail_sender_email